# Copy to keystore.properties and point at your own keystore.
# Generate one with:
#   keytool -genkeypair -v -keystore reseed.keystore -alias reseed \
#           -keyalg RSA -keysize 2048 -validity 10000
# Both the keystore and keystore.properties are gitignored on purpose.
storeFile=reseed.keystore
storePassword=CHANGE_ME
keyAlias=reseed
keyPassword=CHANGE_ME
